# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=dottle_secret
DATABASE_URL=postgresql+asyncpg://dottle:dottle_secret@localhost:5432/dottle

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Backend ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-32-char-random-string
CORS_ORIGINS=http://localhost:3000,https://app.dottle.dev
ENVIRONMENT=development

# ─── AI Features (Anthropic) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Alerts: Slack ───────────────────────────────────────────────────────────
SLACK_DEFAULT_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ─── Alerts: Email (SMTP) ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_FROM_EMAIL=alerts@dottle.dev

# ─── SDK (set in your agent's environment) ───────────────────────────────────
DOTTLE_API_URL=http://localhost:8000/api/v1
DOTTLE_API_KEY=dtl_live_your_key_here
